# Скопируйте этот файл в .env и заполните значения.
# Файл .env НИКОГДА не коммитится в git (см. .gitignore)!

# Токен бота из Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# ID вашего сервера (ПКМ по серверу -> Copy Server ID; включите режим разработчика)
GUILD_ID=123456789012345678

# Необязательно: ID канала, куда бот пишет логи модерации (kick/ban/warn/...)
# Если пусто или не задано — логи модерации не пишутся.
LOG_CHANNEL_ID=
